    {
      "name": "NotFoundError",
      "type": "service",
      "description": "Error class extending native Error for entity-not-found scenarios. Constructor accepts message, optional entityName and entityId. Uses Object.setPrototypeOf for correct prototype chain so instanceof checks work. Captures stack trace via Error.captureStackTrace.",
      "props": null
    },
    {
      "name": "ValidationError",
      "type": "service",
      "description": "Error class extending native Error for input validation failures. Constructor accepts message and optional validationErrors map (field -> error messages). Uses Object.setPrototypeOf for correct prototype chain. Used by services and controllers to signal invalid state transitions or bad input.",
      "props": null
    }
  ]
