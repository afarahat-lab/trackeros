# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way.
#
# 🔴 WHY THIS FILE EXISTS. There was no template, and `knexfile.js` falls back to
# `user: 'postgres', password: 'postgres'` when DATABASE_URL is unset — the SUPERUSER. So the app
# ran as superuser by default, and when a `.env` was accidentally committed on 2026-10-09 the
# credential disclosed was a superuser's rather than an application's. The difference between those
# two incidents is the whole point of this file.
#
# Create the role and database with `./scripts/setup-db-role.sh`, which makes an application role
# that OWNS the database and has no SUPERUSER, CREATEDB or CREATEROLE. That is exactly what knex
# migrations need and nothing more: on PostgreSQL 15+ the `public` schema belongs to
# `pg_database_owner`, so the database owner can create tables there without any extra grant.

# The APPLICATION role — never `postgres`. `setup-db-role.sh` prints this line for you.
DATABASE_URL=postgres://trackeros_app:REPLACE_ME@localhost:5432/trackeros

# Signing key for issued tokens. Generate a fresh one, e.g.:
#   openssl rand -base64 48
# Rotating it invalidates every token already issued.
JWT_SECRET=REPLACE_ME

PORT=3000
NODE_ENV=development

# Optional: point `npm run smoke` at a real Postgres instead of the sqlite path, so all three
# stages run against the engine the repositories actually dial. Same application role.
# SMOKE_DATABASE_URL=postgres://trackeros_app:REPLACE_ME@localhost:5432/trackeros_smoke
